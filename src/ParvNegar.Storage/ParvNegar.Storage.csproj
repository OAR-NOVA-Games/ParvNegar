<Project Sdk="Microsoft.NET.Sdk">
  <!-- Encrypted SQLite (SQLite3 Multiple Ciphers), migrations and the portable backup format. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>ParvNegar.Storage</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ParvNegar.Security\ParvNegar.Security.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="ParvNegar.Storage.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ParvNegar.Storage.Tests" />
  </ItemGroup>
</Project>
