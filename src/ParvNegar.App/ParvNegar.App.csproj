<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF host. Modern = net10.0-windows, Legacy = net48; x86 and x64. Internal development shell. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <ParvIsExecutable>true</ParvIsExecutable>
    <RootNamespace>ParvNegar.App</RootNamespace>
    <AssemblyName>ParvNegar</AssemblyName>
    <BrandKitDir>$(MSBuildThisFileDirectory)..\..\assets\brand-kit\</BrandKitDir>
    <PublisherAssetsDir>$(MSBuildThisFileDirectory)..\..\assets\publisher\</PublisherAssetsDir>
    <ApplicationIcon>$(BrandKitDir)01-App-Icon\ICO\ParvNegar-AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>ParvNegar</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParvNegar.Application\ParvNegar.Application.csproj" />
    <ProjectReference Include="..\ParvNegar.Domain\ParvNegar.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- Brand assets come straight from the approved brand kit (no copies); Link keeps the pack URIs stable. -->
    <Resource Include="$(BrandKitDir)01-App-Icon\ICO\ParvNegar-AppIcon.ico" Link="Assets\Brand\ParvNegar-AppIcon.ico" />
    <Resource Include="$(BrandKitDir)01-App-Icon\PNG\ParvNegar-AppIcon-256.png" Link="Assets\Brand\ParvNegar-AppIcon-256.png" />
    <Resource Include="$(BrandKitDir)02-Logos\PNG\ParvNegar-Logo-Horizontal-Transparent.png" Link="Assets\Brand\ParvNegar-Logo-Horizontal-Transparent.png" />
    <Resource Include="$(PublisherAssetsDir)OAR-NOVA-Games-Logo-White.png" Link="Assets\Publisher\OAR-NOVA-Games-Logo-White.png" />
    <None Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\Vazirmatn-OFL.txt" />
    <None Include="Config\school-profile.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Config\school\*.png" CopyToOutputDirectory="PreserveNewest" Link="Config\school\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Trust anchors (LICENSING-ARCHITECTURE.md §4). Exactly one profile is embedded per build:
    Development (default; trusts development keys only) or Production (-p:ParvTrustProfile=Production;
    trusts production keys only). Production.json stays empty until the owner-approved key ceremony.
  -->
  <PropertyGroup>
    <ParvTrustProfile Condition="'$(ParvTrustProfile)' == ''">Development</ParvTrustProfile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Config\trust\$(ParvTrustProfile).json" LogicalName="ParvNegar.trust-anchors.json" />
    <AssemblyMetadata Include="ParvTrustProfile" Value="$(ParvTrustProfile)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ParvNegar.Licensing\ParvNegar.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ParvNegar.App.Tests" />
  </ItemGroup>
</Project>
