<UserControl x:Class="ParvNegar.App.Views.Pages.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ParvNegar.App.ViewModels"
             xmlns:p="clr-namespace:ParvNegar.App.Views.Pages">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Border Style="{StaticResource Card}" Margin="24" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="{x:Static vm:Strings.SetupTitle}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{x:Static vm:Strings.SetupIntro}" />
                <Label Style="{StaticResource Text.Label}" Content="{x:Static vm:Strings.OwnerUsername}" Target="{Binding ElementName=UserBox}" />
                <TextBox x:Name="UserBox" Text="{Binding OwnerUsername, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight" AutomationProperties.Name="{x:Static vm:Strings.OwnerUsername}" />
                <Label Style="{StaticResource Text.Label}" Content="{x:Static vm:Strings.BootstrapCode}" Target="{Binding ElementName=CodeBox}" />
                <TextBox x:Name="CodeBox" FlowDirection="LeftToRight" FontFamily="{StaticResource Font.Code}" MaxLength="64" AutomationProperties.Name="{x:Static vm:Strings.BootstrapCode}" AutomationProperties.AutomationId="BootstrapCode" />
                <Label Style="{StaticResource Text.Label}" Content="{x:Static vm:Strings.NewPassword}" Target="{Binding ElementName=Pw1}" />
                <PasswordBox x:Name="Pw1" AutomationProperties.Name="{x:Static vm:Strings.NewPassword}" AutomationProperties.AutomationId="NewPassword" />
                <Label Style="{StaticResource Text.Label}" Content="{x:Static vm:Strings.RepeatPassword}" Target="{Binding ElementName=Pw2}" />
                <PasswordBox x:Name="Pw2" AutomationProperties.Name="{x:Static vm:Strings.RepeatPassword}" />
                <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0" Text="{x:Static vm:Strings.PasswordHint}" />
                <p:MessageBanner />
                <Button x:Name="SubmitButton" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,18,0,0" IsDefault="True"
                        Content="{x:Static vm:Strings.CompleteSetup}" Click="OnSubmit" AutomationProperties.AutomationId="CompleteSetup" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
