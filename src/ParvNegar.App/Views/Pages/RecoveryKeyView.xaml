<UserControl x:Class="ParvNegar.App.Views.Pages.RecoveryKeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ParvNegar.App.ViewModels"
             xmlns:p="clr-namespace:ParvNegar.App.Views.Pages">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Border Style="{StaticResource Card}" Margin="24" MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="{x:Static vm:Strings.RecoveryKeyTitle}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{x:Static vm:Strings.RecoveryKeyIntro}" />
                <StackPanel Visibility="{Binding HasCode, Converter={StaticResource BoolToVisibility}}">
                    <TextBox x:Name="CodeText" Style="{StaticResource Text.Code}" Margin="0,16,0,0" Text="{Binding Code, Mode=OneWay}" ContextMenu="{x:Null}"
                             AutomationProperties.Name="{x:Static vm:Strings.RecoveryKey}" AutomationProperties.AutomationId="RecoveryKeyCode" />
                    <Border Style="{StaticResource Message.Warning}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Base}" FontSize="14" Foreground="{DynamicResource Brush.Warning}" Text="{x:Static vm:Strings.RecoveryKeyWarning}" />
                            <TextBlock Style="{StaticResource Text.Base}" FontSize="13" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Warning}" Text="{x:Static vm:Strings.RecoveryKeyStore}" />
                            <TextBlock Style="{StaticResource Text.Base}" FontSize="13" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Warning}" Text="{x:Static vm:Strings.CopyToClipboardWarning}" />
                        </StackPanel>
                    </Border>
                    <Label Style="{StaticResource Text.Label}" Content="{x:Static vm:Strings.RecoveryKeyConfirmPrompt}" Target="{Binding ElementName=LastGroup}" />
                    <TextBox x:Name="LastGroup" MaxLength="12" Width="180" HorizontalAlignment="Left" FlowDirection="LeftToRight" FontFamily="{StaticResource Font.Code}"
                             AutomationProperties.Name="{x:Static vm:Strings.RecoveryKeyConfirmPrompt}" AutomationProperties.AutomationId="RecoveryKeyLastGroup" />
                    <p:MessageBanner />
                    <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,18,0,0" IsDefault="True"
                            Content="{x:Static vm:Strings.RecoveryKeyConfirm}" Click="OnConfirm" AutomationProperties.AutomationId="ConfirmRecoveryKey" />
                </StackPanel>
                <StackPanel Visibility="{Binding LacksCode, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Message.Warning}">
                        <TextBlock Style="{StaticResource Text.Base}" FontSize="14" Foreground="{DynamicResource Brush.Warning}" Text="{x:Static vm:Strings.RecoveryKeyLost}" />
                    </Border>
                    <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,18,0,0" Content="{x:Static vm:Strings.RecoveryKeyNew}" Command="{Binding NewKeyCommand}" />
                    <p:MessageBanner />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
