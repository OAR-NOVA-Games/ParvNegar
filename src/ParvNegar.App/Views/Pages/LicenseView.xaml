<UserControl x:Class="ParvNegar.App.Views.Pages.LicenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ParvNegar.App.ViewModels"
             xmlns:p="clr-namespace:ParvNegar.App.Views.Pages">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Border Style="{StaticResource Card}" Margin="24" MaxWidth="660" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="{x:Static vm:Strings.LicenseTitle}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{x:Static vm:Strings.LicenseIntro}" />

                <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource Brush.SurfaceAlt}">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Text.Base}" FontSize="15" FontWeight="Medium" Text="{Binding Status}" AutomationProperties.AutomationId="LicenseStatus" />
                        <Grid Margin="0,6,0,0" Visibility="{Binding IsValid, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Text.Small}" Text="{x:Static vm:Strings.LicenseType}" Margin="0,0,14,2" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Small}" Text="{x:Static vm:Strings.LicensePerpetual}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource Text.Small}" Text="{x:Static vm:Strings.LicenseCustomer}" Margin="0,0,14,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Small}" Text="{Binding CustomerRef}" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="2" Style="{StaticResource Text.Small}" Text="{x:Static vm:Strings.LicenseId}" Margin="0,0,14,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.Small}" Text="{Binding LicenseIdText}" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding IsInvalid, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Text.Section}" Text="{x:Static vm:Strings.LicenseStep1}" />
                    <Button x:Name="CreateRequestButton" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Content="{x:Static vm:Strings.CreateRequest}"
                            Command="{Binding CreateRequestCommand}" AutomationProperties.AutomationId="CreateRequest" />
                    <StackPanel Visibility="{Binding HasConfirmation, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                        <TextBox Style="{StaticResource Text.Code}" Text="{Binding Confirmation, Mode=OneWay}" AutomationProperties.Name="کد تأیید درخواست" />
                        <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0" Text="{x:Static vm:Strings.RequestNoSecrets}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Text="{x:Static vm:Strings.LicenseStep2}" />
                    <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Content="{x:Static vm:Strings.ImportLicense}"
                            Command="{Binding ImportCommand}" AutomationProperties.AutomationId="ImportLicense" />
                </StackPanel>

                <p:MessageBanner />
                <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,18,0,0" Content="{x:Static vm:Strings.Continue}"
                        Command="{Binding ContinueCommand}" Visibility="{Binding IsValid, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="LicenseContinue" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
