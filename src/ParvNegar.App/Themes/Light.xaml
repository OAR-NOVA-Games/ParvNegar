<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      Light theme. Palette from the approved brand identity board:
      navy #14233D (primary), teal #13A9A6 (accent), gold #D5A857 (complement), ivory #F6F7F4 (background).
      Dark.xaml defines exactly the same keys (semantic tokens); views use DynamicResource only, so the
      theme switches at runtime without a restart. Contrast targets: body text ≥ 4.5:1, large text ≥ 3:1.
    -->
    <sys:String x:Key="Theme.Name">light</sys:String>
    <sys:Boolean x:Key="Theme.IsDark">False</sys:Boolean>

    <Color x:Key="Color.Primary">#14233D</Color>
    <Color x:Key="Color.Accent">#13A9A6</Color>
    <Color x:Key="Color.Complement">#9A6B12</Color>
    <Color x:Key="Color.Background">#F6F7F4</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#EEF1F4</Color>
    <Color x:Key="Color.TextPrimary">#14233D</Color>
    <Color x:Key="Color.TextSecondary">#4A5568</Color>
    <Color x:Key="Color.Border">#C9D1DB</Color>
    <Color x:Key="Color.FocusRing">#0E7C7A</Color>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Complement" Color="{StaticResource Color.Complement}" />
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextOnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#7A8494" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton" Color="#14233D" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#22375C" />
    <SolidColorBrush x:Key="Brush.SecondaryHover" Color="#E6EAEF" />
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#8C97A8" />
    <SolidColorBrush x:Key="Brush.Error" Color="#A61B1B" />
    <SolidColorBrush x:Key="Brush.ErrorSurface" Color="#FDECEC" />
    <SolidColorBrush x:Key="Brush.Success" Color="#0F6B3C" />
    <SolidColorBrush x:Key="Brush.SuccessSurface" Color="#E7F6EE" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#7A4E00" />
    <SolidColorBrush x:Key="Brush.WarningSurface" Color="#FFF4DC" />
    <SolidColorBrush x:Key="Brush.Header" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Footer" Color="#14233D" />
    <SolidColorBrush x:Key="Brush.FooterText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.FooterAccent" Color="#D5A857" />
    <SolidColorBrush x:Key="Brush.Code" Color="#F1F4F8" />
</ResourceDictionary>
