<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      Dark theme (owner approval 2026-11-27, supersedes Light-only). Same keys as Light.xaml.
      Built from the brand navy family; teal stays the accent. Logos are never recolored: the school logo
      uses its owner-supplied white-lettering variant, and the product header shows the approved app icon
      (the brand kit has no product logo for dark surfaces).
    -->
    <sys:String x:Key="Theme.Name">dark</sys:String>
    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>

    <Color x:Key="Color.Primary">#14233D</Color>
    <Color x:Key="Color.Accent">#2CC5C2</Color>
    <Color x:Key="Color.Complement">#E2BC74</Color>
    <Color x:Key="Color.Background">#0D1626</Color>
    <Color x:Key="Color.Surface">#16233A</Color>
    <Color x:Key="Color.SurfaceAlt">#1D2D49</Color>
    <Color x:Key="Color.TextPrimary">#EEF2F7</Color>
    <Color x:Key="Color.TextSecondary">#B4BFCE</Color>
    <Color x:Key="Color.Border">#34466A</Color>
    <Color x:Key="Color.FocusRing">#5FE0DC</Color>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Complement" Color="{StaticResource Color.Complement}" />
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextOnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#8391A6" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" />
    <SolidColorBrush x:Key="Brush.PrimaryButton" Color="#2CC5C2" />
    <SolidColorBrush x:Key="Brush.PrimaryButtonText" Color="#0B1420" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#57D6D3" />
    <SolidColorBrush x:Key="Brush.SecondaryHover" Color="#24375A" />
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#0F1A2D" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#6A7C9C" />
    <SolidColorBrush x:Key="Brush.Error" Color="#FF9C9C" />
    <SolidColorBrush x:Key="Brush.ErrorSurface" Color="#3A1A22" />
    <SolidColorBrush x:Key="Brush.Success" Color="#7EE2AE" />
    <SolidColorBrush x:Key="Brush.SuccessSurface" Color="#14332A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F3CD7D" />
    <SolidColorBrush x:Key="Brush.WarningSurface" Color="#3A2E14" />
    <SolidColorBrush x:Key="Brush.Header" Color="#111D31" />
    <SolidColorBrush x:Key="Brush.Footer" Color="#09101C" />
    <SolidColorBrush x:Key="Brush.FooterText" Color="#E3E9F2" />
    <SolidColorBrush x:Key="Brush.FooterAccent" Color="#E2BC74" />
    <SolidColorBrush x:Key="Brush.Code" Color="#0F1A2D" />
</ResourceDictionary>
